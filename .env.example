# Jadwalin: contoh konfigurasi.
# Situs ini 100% frontend statis, jadi nilai-nilai ini dimasukkan langsung
# ke services/supabase.js (SUPABASE_URL dan SUPABASE_ANON_KEY).
# Hanya pakai anon/public key. JANGAN taruh service_role key di frontend.

SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
